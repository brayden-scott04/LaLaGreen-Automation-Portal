# Core app secrets — required
JWT_SECRET=<64-character hex string>
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Amazon SP-API (pricing/listings — used by Price Change Plans and other SKU pricing lookups)
# Separate from the ADS_* credentials below.
REFRESH_TOKEN=<refresh token with pricing/listings scope>
CLIENT_ID=<LWA client id>
CLIENT_SECRET=<LWA client secret>
SELLER_ID=<Amazon seller id>

# Amazon Advertising API (Sponsored Brands Upload -> "Upload to Amazon")
# Separate from SP-API creds above. Refresh token needs the advertising::campaign_management scope.
# Without these, "Download bulk file" still works; "Upload to Amazon" surfaces a clear error.
ADS_CLIENT_ID=<LWA client id>
ADS_CLIENT_SECRET=<LWA client secret>
ADS_REFRESH_TOKEN=<refresh token with advertising::campaign_management scope>